{
  "name": "spo2sensorcable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.jsx --outDir .ssr-build",
    "prerender": "node scripts/prerender.mjs",
    "build": "npm run sitemap && npm run build:client && npm run build:ssr && npm run prerender",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "lucide-react": "0.469.0",
    "postcss": "8.4.49",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "tailwindcss": "3.4.17",
    "vite": "5.4.11"
  },
  "devDependencies": {
    "@rollup/wasm-node": "4.24.4"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.24.4"
  },
  "pnpm": {
    "overrides": {
      "rollup": "npm:@rollup/wasm-node@4.24.4"
    }
  }
